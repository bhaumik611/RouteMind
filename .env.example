# ==============================================================================
# RouteMind LLM Gateway - Environment Configuration
# ==============================================================================

# Application Metadata
APP_NAME="RouteMind"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/v1"

# CRITICAL ZERO-BUDGET SAFETY GUARD
# When true, non-free models/providers will be strictly rejected at runtime
FREE_ONLY=true

# Database & Cache Connections (Defaults for local development)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/routemind"
REDIS_URL="redis://localhost:6379/0"

# Provider API Keys (Free Tiers Only)
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""

# Default Free Models
OPENROUTER_MODEL="meta-llama/llama-3-8b-instruct:free"
GEMINI_MODEL="gemini-1.5-flash"
LOCAL_MODEL="mock-free-model"

# Virtual Quota & Safe Execution Limits
MAX_DAILY_REQUESTS=5000
MAX_DAILY_TOKENS=1000000
MAX_REQUEST_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=30.0

# Circuit Breaker & Resiliency Defaults
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0
MAX_FALLBACK_ATTEMPTS=3

# Default Routing Strategy
DEFAULT_ROUTING_STRATEGY="bandit"
